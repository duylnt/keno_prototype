# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Public site
SITE_URL=http://127.0.0.1:8000
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=

# Google Analytics 4 Data API
# Path to a Google Cloud service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_ID=

# Google Search Console API
# Same service account JSON can be reused if the account is added as a GSC user
GSC_SITE_URL=https://keno.example.com/
GSC_CREDENTIALS_PATH=

# Optional Google Maps (directions still work via maps URL without a key)
GOOGLE_MAPS_API_KEY=

# LLM article drafts (optional — CMS falls back to a quality template if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-0

# Conversion / community (CMS Site settings override these when filled)
FACEBOOK_APP_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_URL=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GROUP_URL=
FACEBOOK_COMMENTS_URL=
ZALO_GROUP_URL=

# Optional article writer (CMS)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-0
